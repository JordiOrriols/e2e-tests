{
  "name": "@jordiorriols/e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for jordiorriols projects using Playwright",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:website": "playwright test --project=website-localhost --project=website-production",
    "test:airmap": "playwright test --project=airmap-localhost --project=airmap-production",
    "test:ladders": "playwright test --project=ladders-localhost --project=ladders-production",
    "test:localhost": "playwright test --project=website-localhost --project=airmap-localhost --project=ladders-localhost",
    "test:production": "playwright test --project=website-production --project=airmap-production --project=ladders-production",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "compare": "tsx scripts/compare-screenshots.ts",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "ladders": "playwright test --project=ladders-localhost",
    "ladders:smoke": "playwright test --project=ladders-localhost --grep @smoke",
    "ladders:auth": "playwright test --project=ladders-localhost --grep @auth",
    "ladders:teams": "playwright test --project=ladders-localhost --grep @teams",
    "ladders:members": "playwright test --project=ladders-localhost --grep @members",
    "ladders:goals": "playwright test --project=ladders-localhost --grep @goals",
    "ladders:evaluations": "playwright test --project=ladders-localhost --grep @evaluations",
    "ladders:sharing": "playwright test --project=ladders-localhost --grep @sharing",
    "ladders:visibility": "playwright test --project=ladders-localhost --grep @visibility",
    "ladders:reference": "playwright test --project=ladders-localhost --grep @reference",
    "ladders:responsive": "playwright test --project=ladders-localhost --grep @responsive",
    "ladders:visual": "playwright test --project=ladders-localhost --grep @visual",
    "ladders:visual:update": "playwright test --project=ladders-localhost --grep @visual --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
